{
  "name": "pdf-to-txt",
  "description": "Desktop app and CLI to extract text from PDF files into .txt",
  "author": {
    "name": "Taylor Ivanoff"
  },
  "version": "1.0.13",
  "repository": "https://github.com/taylorivanoff/pdf-to-txt",
  "type": "module",
  "bin": {
    "pdf-to-txt": "./src/cli.js"
  },
  "scripts": {
    "dev": "node scripts/run-tauri.cjs dev",
    "start": "node scripts/run-tauri.cjs dev",
    "build": "node scripts/run-tauri.cjs build",
    "tauri": "node scripts/run-tauri.cjs",
    "release": "node scripts/run-tauri.cjs build",
    "bump": "node scripts/bump-version.cjs",
    "icon": "node scripts/run-tauri.cjs icon resources/icon.png",
    "cli": "node src/cli.js",
    "convert": "node src/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "eslint": "^9.39.5",
    "@eslint/js": "^9.39.5",
    "globals": "^16.0.0"
  }
}
