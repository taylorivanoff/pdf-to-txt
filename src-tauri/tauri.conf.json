{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF to TXT",
  "version": "1.0.13",
  "identifier": "io.github.taylorivanoff.pdf-to-txt",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDF to TXT",
        "width": 720,
        "height": 560,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../sidecar/host.mjs",
      "../src/extract.js",
      "../src/polyfill.js"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "./windows/installer.nsi",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
